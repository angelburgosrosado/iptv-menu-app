# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# IPTV.MENU PRODUCTION STACK CONFIGURATION (Neon / Render / EAS / Stripe)
# ==============================================================================

NODE_ENV=production
APP_ENV=production

# 1. Neon Database (Serverless PostgreSQL)
# Get this from your Neon Console (https://console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-cold-smoke-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Stripe Billing & Subscriptions
# Configure webhooks pointing to https://iptv.menu/api/webhooks/stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_PRO_LIFETIME=price_...
STRIPE_PRICE_BUILDER_MONTHLY=price_...
STRIPE_PRICE_BUILDER_YEARLY=price_...
STRIPE_PRICE_BUILDER_LIFETIME=price_...

# 3. Expo Application Services (EAS) APK App Builder
EXPO_PROJECT_ID=1437b933-39d1-42b3-bb8d-803a5f33909e
EXPO_ACCESS_TOKEN=your-expo-access-token-here
EXPO_ACCOUNT_NAME=your-expo-username

# 4. Storage & Artifacts (Vercel Blob / S3-compatible)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# 5. Internal Worker Connection (Render Private Network)
INTERNAL_WORKER_URL=http://iptv-worker:3000

# 6. Admin Access
ADMIN_ALLOWED_EMAILS=angelburgosrosado@gmail.com,admin@iptv.menu

# 7. Frontend Client Configuration (Vite)
# For unified production on iptv.menu, leave empty so requests use relative /api
VITE_API_URL=
VITE_ADSENSE_CLIENT_ID=ca-pub-1578853238313624
