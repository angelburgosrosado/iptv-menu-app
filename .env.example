# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# IPTV.MENU PRODUCTION STACK CONFIGURATION
NODE_ENV=development
APP_ENV=dev

# Neon Database (PostgreSQL)
DATABASE_URL="postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
GOOGLE_CLOUD_PROJECT=iptv-menu-dev
FIREBASE_PROJECT_ID=iptv-menu-dev
FIREBASE_CLIENT_EMAIL=your-sa-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_WEB_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=iptv-menu-dev.firebaseapp.com
FIREBASE_STORAGE_BUCKET=iptv-menu-dev.appspot.com

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# GCS_BUILD_BUCKET=iptv-menu-prod-build-artifacts
#
# Expo Application Services (EAS) Configuration
EXPO_PROJECT_ID=1437b933-39d1-42b3-bb8d-803a5f33909e
EXPO_ACCESS_TOKEN=your-expo-access-token-here
EXPO_ACCOUNT_NAME=your-expo-username

# Worker Connection URL
INTERNAL_WORKER_URL=http://iptv-worker:3000

# Admin configuration
ADMIN_ALLOWED_EMAILS=angelburgosrosado@gmail.com,admin@iptv.menu
